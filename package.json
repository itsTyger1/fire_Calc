{
  "name": "fire-projector",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "concurrently -k \"npm:dev\" \"npm:desktop:launch\"",
    "desktop:launch": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "tsc -b && vite build",
    "build:desktop": "npm run build && electron-builder --win nsis",
    "build:portable": "npm run build && electron-builder --win portable",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "npm run build && electron scripts/ui-smoke.cjs",
    "clean": "node scripts/clean.cjs"
  },
  "dependencies": {
    "lucide-react": "1.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0",
    "wait-on": "9.1.0",
    "@vitejs/plugin-react": "6.1.1"
  },
  "build": {
    "appId": "com.fireprojector.desktop",
    "productName": "FIRE Projector",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "FIRE-Projector-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "FIRE Projector"
    }
  },
  "description": "A private desktop FIRE planner with consolidated inputs and scenario comparisons"
}
